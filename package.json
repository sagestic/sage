{
  "name": "@sage/app",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "lint:staged": "lint-staged",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo typecheck",
    "db:tunnel": "bash scripts/db-tunnel.sh",
    "db:tunnel:dev": "bash scripts/db-tunnel.sh dev",
    "db:tunnel:prod": "bash scripts/db-tunnel.sh production",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": "eslint --fix --max-warnings=0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.7.1",
    "@commitlint/config-conventional": "^19.7.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "eslint": "^9.39.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.10.11",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  },
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=18"
  }
}
